# standard-ts-lib as a first-party npm package.
#
# Consumers (md-bug frontend/integration tests) depend on it through pnpm
# `file:../../standard-ts-lib` specifiers, which resolve via the
# `tools/standard-ts-lib` symlink — so within Bazel this package is addressed
# as //tools/standard-ts-lib (the `common/standard-ts-lib` path is in
# .bazelignore to avoid a duplicate package through the symlink).
#
# The library ships raw TypeScript (deep imports like
# `standard-ts-lib/src/result`), so the npm package is just package.json + src.

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")

# Raw sources, for consumers that resolve `standard-ts-lib/*` by workspace
# path (the integration tests' jest/tsconfig path mappings). js_library rather
# than filegroup so rules_js can consume them across package boundaries.
js_library(
    name = "srcs",
    srcs = ["package.json"] + glob(["src/**/*.ts"]),
    visibility = ["//visibility:public"],
)

# Named `pkg` because that is the target name npm_translate_lock generates
# references to for `file:` directory dependencies.
npm_package(
    name = "pkg",
    srcs = ["package.json"] + glob(["src/**/*.ts"]),
    package = "standard-ts-lib",
    visibility = ["//visibility:public"],
)
